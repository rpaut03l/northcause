# Copy to .dev.vars for local development. Never commit .dev.vars.
# Optional: OpenAI-compatible chat completions endpoint for the external model provider.
# Leave empty to use only the local rule-based provider.
MODEL_API_KEY=
MODEL_ENDPOINT=
MODEL_NAME=
# Optional: read-only GitHub token (Actions: read, Contents: read) for the GitHub Actions adapter.
GITHUB_TOKEN=
SANDBOX_ENABLED=true
